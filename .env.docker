# Environment Configuration for Docker

# PostgreSQL Database
POSTGRES_USER=scanner
POSTGRES_PASSWORD=scanner123
POSTGRES_DB=network_scanner
DATABASE_URL=postgresql+psycopg2://scanner:scanner123@db:5432/network_scanner

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# API Configuration
ENV=production
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
LOG_LEVEL=INFO

# Schema/data lifecycle (containers run Alembic in the entrypoint)
AUTO_CREATE_SCHEMA=false
DATA_RETENTION_DAYS=30

# CORS - Update with your domain in production
CORS_ORIGINS=["http://localhost", "http://localhost:80", "https://yourdomain.com"]

# Scanning Configuration
MAX_CONCURRENT_SCANS=5
DEFAULT_SCAN_TIMEOUT=300
MAX_PORTS_PER_SCAN=65535
MAX_HOSTS_PER_SCAN=1024
RESOLVE_HOSTNAMES=true

# Security - CHANGE THIS IN PRODUCTION!
SECRET_KEY=CHANGE-THIS-TO-A-SECURE-RANDOM-KEY-IN-PRODUCTION

# Frontend
VITE_API_URL=http://localhost
VITE_WS_URL=ws://localhost
