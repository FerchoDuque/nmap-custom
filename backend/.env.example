# Environment Configuration
ENV=development

# Database
DATABASE_URL=sqlite:///./network_scanner.db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Scanning Configuration
MAX_CONCURRENT_SCANS=5
DEFAULT_SCAN_TIMEOUT=300
MAX_PORTS_PER_SCAN=65535
MAX_HOSTS_PER_SCAN=1024
# Disable reverse DNS in latency-sensitive or offline environments.
RESOLVE_HOSTNAMES=true

# Schema and data lifecycle
# `true` lets local dev create tables with create_all; containers run Alembic
# in the entrypoint and set this to `false`.
AUTO_CREATE_SCHEMA=true
# Delete finished scans older than N days (0 disables the daily purge).
DATA_RETENTION_DAYS=30

# Security
SECRET_KEY=your-secret-key-change-in-production
